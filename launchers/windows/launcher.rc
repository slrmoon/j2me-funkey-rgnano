#include <windows.h>
#include <commctrl.h>
#include "launcher_res.h"

IDI_APP ICON "launcher.ico"
1 24 "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "FunKey J2ME launcher"
            VALUE "ProductName", "FunKey J2ME runtime (phoneME)"
            VALUE "FileVersion", "2.0"
            VALUE "OriginalFilename", "FunKeyJ2ME.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_MAIN DIALOGEX 0, 0, 352, 268
STYLE DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "FunKey J2ME"
FONT 9, "MS Shell Dlg 2"
BEGIN
    CONTROL         "", IDC_TAB, "SysTabControl32", WS_TABSTOP, 6, 6, 340, 214
    AUTOCHECKBOX    "Own settings for the selected game", IDC_OWN, 8, 226, 200, 10
    LTEXT           "", IDC_SCOPE, 8, 239, 230, 9
    DEFPUSHBUTTON   "Play", IDC_PLAY, 240, 246, 50, 16
    PUSHBUTTON      "Close", IDCANCEL, 296, 246, 50, 16
END

IDD_GAMES DIALOGEX 0, 0, 328, 194
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "MS Shell Dlg 2"
BEGIN
    CONTROL         "", IDC_GAMES, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_SORTASCENDING | WS_BORDER | WS_TABSTOP, 4, 4, 320, 160
    LTEXT           "", IDC_DIR, 4, 168, 320, 9, SS_PATHELLIPSIS
    PUSHBUTTON      "Open a game...", IDC_OPEN, 4, 178, 70, 14
    PUSHBUTTON      "Games folder...", IDC_FOLDER, 78, 178, 70, 14
    PUSHBUTTON      "Refresh", IDC_REFRESH, 152, 178, 50, 14
    RTEXT           "", IDC_COUNT, 206, 181, 118, 9
END

IDD_DISPLAY DIALOGEX 0, 0, 328, 194
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "MS Shell Dlg 2"
BEGIN
    GROUPBOX        "Window", -1, 4, 2, 320, 78
    LTEXT           "Window size:", -1, 12, 16, 70, 9
    COMBOBOX        IDC_SCALE, 90, 14, 120, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Start in full screen (F11 / Alt+Enter switch)", IDC_FULLSCREEN, 216, 12, 104, 20, BS_MULTILINE
    LTEXT           "Picture:", -1, 12, 34, 70, 9
    COMBOBOX        IDC_MODE, 90, 32, 120, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Filter:", -1, 12, 52, 70, 9
    COMBOBOX        IDC_FILTER, 90, 50, 120, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "The window can be resized with the mouse; the picture follows.", -1, 12, 66, 300, 9

    GROUPBOX        "Phone", -1, 4, 84, 320, 104
    LTEXT           "Screen size:", -1, 12, 98, 70, 9
    COMBOBOX        IDC_LCD, 90, 96, 120, 140, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Frame limit:", -1, 12, 116, 70, 9
    COMBOBOX        IDC_FPS, 90, 114, 120, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Java memory:", -1, 12, 134, 70, 9
    COMBOBOX        IDC_HEAP, 90, 132, 120, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "JIT compiler (faster)", IDC_JIT, 216, 98, 104, 10
    AUTOCHECKBOX    "Verify bytecode", IDC_VERIFY, 216, 112, 104, 10
    LTEXT           "VM options:", -1, 12, 152, 70, 9
    EDITTEXT        IDC_VMARGS, 90, 150, 226, 13, ES_AUTOHSCROLL
    LTEXT           "Screen size Auto: 240x240, i-appli: the .jam DrawArea. Changes apply at the next start.", -1, 12, 168, 304, 16
END

IDD_CONTROLS DIALOGEX 0, 0, 328, 194
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "MS Shell Dlg 2"
BEGIN
    CONTROL         "", IDC_KEYS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 4, 4, 320, 146
    PUSHBUTTON      "Add key...", IDC_ADDKEY, 4, 154, 60, 14
    PUSHBUTTON      "Clear", IDC_CLEARKEY, 68, 154, 50, 14
    PUSHBUTTON      "Defaults", IDC_DEFKEYS, 122, 154, 50, 14
    LTEXT           "Soft keys:", -1, 180, 157, 36, 9
    COMBOBOX        IDC_PHONE, 216, 155, 108, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Double-click a phone key and press a PC key (up to 3 each). Soft keys: the codes differ by phone brand; try another if a game ignores them.", -1, 4, 172, 320, 18
END

IDD_SOUND DIALOGEX 0, 0, 328, 194
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "MS Shell Dlg 2"
BEGIN
    GROUPBOX        "Sound", -1, 4, 2, 320, 64
    AUTOCHECKBOX    "No sound", IDC_MUTE, 12, 16, 100, 10
    LTEXT           "Volume:", -1, 12, 32, 50, 9
    CONTROL         "", IDC_VOLUME, "msctls_trackbar32", TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP, 64, 29, 180, 16
    LTEXT           "", IDC_VOLTEXT, 250, 32, 40, 9
    LTEXT           "MIDI synth:", -1, 12, 50, 50, 9
    COMBOBOX        IDC_SYNTH, 64, 48, 120, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Logs and debugging", -1, 4, 70, 320, 118
    AUTOCHECKBOX    "Write a log file (data\\logs\\<game>.log)", IDC_LOG, 12, 84, 200, 10
    AUTOCHECKBOX    "Show the runtime console window instead", IDC_CONSOLE, 12, 98, 200, 10
    AUTOCHECKBOX    "Log keys", IDC_LOGKEYS, 12, 116, 100, 10
    AUTOCHECKBOX    "Log events", IDC_LOGEVENTS, 12, 130, 100, 10
    AUTOCHECKBOX    "Log display / scaling", IDC_LOGDISPLAY, 12, 144, 100, 10
    AUTOCHECKBOX    "FPS counter in the game", IDC_SHOWFPS, 12, 158, 120, 10
    AUTOCHECKBOX    "Log audio", IDC_LOGAUDIO, 120, 116, 80, 10
    PUSHBUTTON      "Open the game's log", IDC_OPENLOG, 214, 114, 100, 14
    PUSHBUTTON      "Open the logs folder", IDC_OPENLOGDIR, 214, 132, 100, 14
    LTEXT           "In the game: Esc opens the runtime menu (default keys).", -1, 12, 174, 300, 9
END
