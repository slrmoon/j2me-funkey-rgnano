#include <winver.h>

1 ICON "launcher.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "FunKey J2ME launcher"
            VALUE "ProductName", "FunKey J2ME runtime (phoneME)"
            VALUE "FileVersion", "1.0"
            VALUE "OriginalFilename", "FunKeyJ2ME.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
