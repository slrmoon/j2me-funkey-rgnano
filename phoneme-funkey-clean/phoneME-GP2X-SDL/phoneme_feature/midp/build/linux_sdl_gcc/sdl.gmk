######################################################################
# SDL Embedded specific defines and targets
######################################################################

EXTRA_CFLAGS += -D_GNU_SOURCE=1 -D_REENTRANT

ifeq ($(TARGET_CPU), arm)
  ifneq ($(SDL_CONFIG),)
    EXTRA_INCLUDES += $(shell $(SDL_CONFIG) --cflags)
    SDL_LIBS       := $(shell $(SDL_CONFIG) --libs)
  else
    EXTRA_INCLUDES += -I/usr/include/SDL
    SDL_LIBS       := -L/usr/lib/arm-linux-gnueabihf -lSDL
  endif
else ifneq ($(shell command -v sdl-config 2>/dev/null),)
  EXTRA_INCLUDES += $(shell sdl-config --cflags)
  SDL_LIBS       := $(shell sdl-config --libs)
else
  EXTRA_INCLUDES += -I/usr/include/SDL
endif

ifeq ($(TARGET_CPU), arm)
  OPENCORE_AMRNB_DIR := $(MIDP_DIR)/src/media-sdl/reference/native/opencore-amrnb
  EXTRA_INCLUDES += -I$(OPENCORE_AMRNB_DIR)
  EXTRA_INCLUDES += -I$(shell $(CC) -print-sysroot)/usr/include/SDL
  LIBS	+= $(SDL_LIBS) -lSDL_image -lSDL_mixer -lSDL_gfx $(SDL_MIXER_EXTRA_LIBS) -lm
  ifneq ($(wildcard $(OPENCORE_AMRNB_DIR)/libopencore-amrnb.a),)
    LIBS += -L$(OPENCORE_AMRNB_DIR) -lopencore-amrnb
  endif
  ifeq ($(USE_LIBFLOAT), true)
    LIBS += -lfloat
  endif
else
  LIBS	+= $(SDL_LIBS) -lSDL_image -lSDL_mixer -lSDL_gfx -lm
endif
