#
# JSR-184 Mobile 3D Graphics module for the FunKey phoneME build.
#

SUBSYSTEMS += jsr184

JSR_184_JAVA_DIR := $(JSR_184_DIR)/src/classes
JSR_184_NATIVE_DIR := $(JSR_184_DIR)/src/native
JSR_184_FUNKEY_NATIVE_DIR := $(JSR_184_NATIVE_DIR)/funkey
JSR_184_M3GCORE_NATIVE_DIR := $(JSR_184_NATIVE_DIR)/upstream/m3g
JSR_184_M3GCORE_EMBEDDED_FILES := \
    $(wildcard $(JSR_184_M3GCORE_NATIVE_DIR)/src/*.c) \
    $(wildcard $(JSR_184_M3GCORE_NATIVE_DIR)/src/*.h) \
    $(wildcard $(JSR_184_M3GCORE_NATIVE_DIR)/inc/*.h) \
    $(wildcard $(JSR_184_FUNKEY_NATIVE_DIR)/*.h)

JSR_184_SOURCEPATH += $(JSR_184_JAVA_DIR)
JSR_184_PACKAGES += javax.microedition.m3g

JAVADOC_ALL_SOURCEPATH += $(JSR_184_SOURCEPATH)
JAVADOC_ALL_PACKAGES += $(JSR_184_PACKAGES)

SUBSYSTEM_CONFIGURATION_INPUT_FILES += \
    $(JSR_184_DIR)/src/config/properties_jsr184.xml

MODULE_JSR_184_API_JAVA_FILES := \
    $(wildcard $(JSR_184_JAVA_DIR)/javax/microedition/m3g/*.java)

SUBSYSTEM_JSR_184_JAVA_FILES += \
    $(MODULE_JSR_184_API_JAVA_FILES)

vpath % $(JSR_184_FUNKEY_NATIVE_DIR)
vpath % $(JSR_184_M3GCORE_NATIVE_DIR)/src

SUBSYSTEM_JSR_184_EXTRA_INCLUDES += \
    -I$(JSR_184_FUNKEY_NATIVE_DIR) \
    -I$(JSR_184_M3GCORE_NATIVE_DIR)/inc \
    -I$(JSR_184_M3GCORE_NATIVE_DIR)/src \
    -I$(MIDP_OUTPUT_DIR) \
    -I$(MIDP_DIR)/src/core/global_status/include \
    -I$(MIDP_DIR)/src/core/kni_util/include \
    -I$(MIDP_DIR)/src/core/log_base/include \
    -I$(MIDP_DIR)/src/lowlevelui/graphics/include \
    -I$(MIDP_DIR)/src/lowlevelui/graphics_util/include \
    -I$(MIDP_DIR)/src/lowlevelui/graphics_api/include \
    -I$(MIDP_DIR)/src/lowlevelui/graphics/putpixel/include

# The Java API contains native methods, so enabled JSR-184 builds must include
# the KNI layer unless a developer is intentionally isolating Java/preverify.
FUNKEY_ENABLE_M3G_NATIVE ?= true

ifeq ($(FUNKEY_ENABLE_M3G_NATIVE), true)
SUBSYSTEM_JSR_184_NATIVE_FILES += \
    m3g_funkey_kni.c \
    m3g_funkey_coverage_kni.c \
    m3g_funkey_soft.c \
    m3g_core.c
endif

ROMGEN_INCLUDE_PATHS += $(JSR_184_DIR)/src/config
ROMGEN_CFG_FILES += jsr184_rom.cfg

$(MIDP_OUTPUT_DIR)/classes.zip:: $(SUBSYSTEM_JSR_184_JAVA_FILES)
	$(appendjavafiles)

JTWI_NATIVE_FILES += $(SUBSYSTEM_JSR_184_NATIVE_FILES)
EXTRA_INCLUDES += $(SUBSYSTEM_JSR_184_EXTRA_INCLUDES)
EXTRA_CFLAGS += -DM3G_TARGET_GENERIC -DM3G_USE_NGL_API
LIBS += -lz -lm

# m3g_core.c textually includes the core modules and FunKey NGL backend, so
# edits in included implementation or backend headers must rebuild the object.
$(OBJ_DIR)/m3g_core.o: $(JSR_184_M3GCORE_EMBEDDED_FILES) $(JSR_184_DIR)/src/config/subsystem.gmk

# Upstream M3G intentionally inspects IEEE float bits through integer lvalues.
# Keep modern GCC from optimizing that matrix/math code under strict aliasing.
$(OBJ_DIR)/m3g_core.o: override CFLAGS += -fno-strict-aliasing
